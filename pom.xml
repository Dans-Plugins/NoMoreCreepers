<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dansplugins</groupId>
    <artifactId>NoMoreCreepers</artifactId>
    <version>2.0.0-SNAPSHOT-8-8-2026</version>
    <packaging>jar</packaging>

    <name>NoMoreCreepers</name>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- ponder is published as an uber jar that bundles JUnit 4 and Hamcrest
                                 inside its own artifact, so the <exclusions> on the dependency below
                                 cannot reach them. Filtering them out here keeps a test framework the
                                 plugin never calls off the server classpath. preponderous/ponder/tests
                                 holds ponder's own test class, which is the only class this filter
                                 would otherwise have kept that references JUnit; the two license
                                 files cover only the removed libraries. Note that this filter is
                                 pinned to ponder's coordinates: should ponder ever stop shipping as
                                 an uber jar, or change coordinates, it silently stops applying, so
                                 re-check the JAR's entry list after a ponder version bump. -->
                            <filters>
                                <filter>
                                    <artifact>com.github.Preponderous-Software:ponder</artifact>
                                    <excludes>
                                        <exclude>org/junit/**</exclude>
                                        <exclude>junit/**</exclude>
                                        <exclude>org/hamcrest/**</exclude>
                                        <exclude>preponderous/ponder/tests/**</exclude>
                                        <exclude>LICENSE.txt</exclude>
                                        <exclude>LICENSE-junit.txt</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
        <repository>
		    <id>jitpack.io</id>
		    <url>https://jitpack.io</url>
		</repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.13.1-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.Preponderous-Software</groupId>
            <artifactId>ponder</artifactId>
            <version>1.1</version>
            <scope>compile</scope>
            <!-- ponder declares junit at compile scope, which puts a second copy of the same
                 classes it already bundles onto the classpath. Excluding it settles the shade
                 plugin's overlapping-class warning for JUnit and Hamcrest, though the warning
                 still fires for the IntelliJ annotations, which are duplicated the same way.
                 The copy bundled inside ponder is handled by the filter above. -->
            <exclusions>
                <exclusion>
                    <groupId>junit</groupId>
                    <artifactId>junit</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Test dependencies must stay on their last Java 8 compatible releases,
             since the project targets Java 8 and the Build workflow runs on JDK 8. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>4.11.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
